def parse_frame_number(frame_str: str) -> int:
    m = re.search(r'(\d+)', frame_str)
    return int(m.group(1)) if m else None

def load_pore_data(filepath: str, timestep_fs: float = 0.5, sep: str = ';') -> pd.DataFrame:
    df = pd.read_csv(filepath, sep=sep, engine='python')
    df.columns = ['frame', 'Df_A']
    df['frame_number'] = df['frame'].apply(parse_frame_number)
    df = df.dropna(subset=['frame_number'])
    df['frame_number'] = df['frame_number'].astype(int)
    df['time_fs'] = df['frame_number'] * timestep_fs
    df['time_ps'] = df['time_fs'] / 1000.0
    df = df.sort_values('time_fs').reset_index(drop=True)
    return df[['frame', 'frame_number', 'time_fs', 'time_ps', 'Df_A']]

