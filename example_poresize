import sys
from pathlib import Path

ROOT = Path.cwd()  # deve ser a raiz do projeto
sys.path.insert(0, str(ROOT))

from scripts.io.cell_reader import read_cell
from scripts.plotting.cell_time_series import (
    plot_cell_angles,
    plot_lattice_lengths,
    plot_volume_vs_time,
    plot_split_violin
)
from scripts.utils.time import (clip_time,clip_time2)
from scripts.analysis.block_avg import (avg_over_replicas, block_averaging)
